<%= form_with(model: playthrough, class: "contents") do |form| %>
  <% if playthrough.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(playthrough.errors.count, "error") %> prohibited this playthrough from being saved:</h2>

      <ul class="list-disc ml-6">
        <% playthrough.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :user_id %>
    <%= form.text_field :user_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": playthrough.errors[:user_id].none?, "border-red-400 focus:outline-red-600": playthrough.errors[:user_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :score %>
    <%= form.number_field :score, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": playthrough.errors[:score].none?, "border-red-400 focus:outline-red-600": playthrough.errors[:score].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.number_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": playthrough.errors[:status].none?, "border-red-400 focus:outline-red-600": playthrough.errors[:status].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :text_hint_used %>
    <%= form.checkbox :text_hint_used, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": playthrough.errors[:text_hint_used].none?, "border-red-400 focus:outline-red-600": playthrough.errors[:text_hint_used].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :fifty_hint_user %>
    <%= form.checkbox :fifty_hint_user, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": playthrough.errors[:fifty_hint_user].none?, "border-red-400 focus:outline-red-600": playthrough.errors[:fifty_hint_user].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :question_swap_used %>
    <%= form.checkbox :question_swap_used, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": playthrough.errors[:question_swap_used].none?, "border-red-400 focus:outline-red-600": playthrough.errors[:question_swap_used].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
