<% content_for :title, "Hra | Úroveň #{@current_level}" %>

<%= render "layouts/header" do %>
  <div class="text-2xl">
    <% if @playthrough_won %>
      Výhra
    <% elsif @playthrough_lost %>
      Prohra
    <% else %>
      Současné skóre: <span class="font-bold"><%= @playthrough.score || 0 %></span>
    <% end %>
  </div>
<% end %>

<% if @playthrough_won %>
  <%= render partial: "won_screen" %>
<% elsif @playthrough_lost %>
  <%= render partial: "lost_screen" %>
<% else %>
  <%= render partial: "gamescreen" %>
<% end %>
