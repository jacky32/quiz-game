<% content_for :title, "Showing playthrough" %>

<section class="flex w-full">
  <div class="flex flex-row items-center justify-center w-full h-48 gap-4 m-2 card bg-base-300 rounded-box">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", class: "h-32" %>
    <% end %>
    </div>
  <div class="flex flex-row items-center justify-center w-full h-48 gap-4 m-2 card bg-base-300 rounded-box">
    Současné skóre: <span class="text-xl font-bold"><%= @playthrough.score %></span>
  </div>
  <div class="flex flex-row items-center justify-center w-full h-48 gap-4 m-2 card bg-base-300 rounded-box">
    <%= link_to edit_user_path(Current.user), class: "text-lg" do %>
      <%= Current.user.name %>
    <% end %>
    <%= link_to edit_user_path(Current.user) do %>
      <%= image_tag Current.user.avatar, class: "h-32 w-32 rounded-full" if Current.user.avatar.attached? %>
    <% end %>
  </div>
</section>
<section class="grid grid-cols-2">
  <div class="">
  </div>
  <div class="">
    <ul class="steps steps-vertical steps-reverse">
      <% (1..10).to_a.each do |level| %>
      <li class="step">
        <%= "1" + "0" * (level - 1) %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
<%= @playthrough.current_question.body %>
