
<div class="w-full mx-auto md:w-96 mt-8">
  <%= form_with model: @user, url: registrations_path do |form| %>
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-4">
      <h1 class="mb-4 text-4xl font-bold mx-auto">Registrace</h1>
      <%= image_tag "logo.png", class: "max-w-xs  max-md:mx-auto" %>

      <label class="w-full label" for="name">Jméno</label>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "nickname", placeholder: "Jméno", class: "w-full input" %>

      <label class="w-full label" for="email_address">Email</label>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "Email", class: "w-full input" %>

      <label class="w-full label" for="password">Heslo</label>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Heslo", maxlength: 72, class: "w-full input" %>

      <label class="w-full label" for="password">Potvrdit heslo</label>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "current-password", placeholder: "Potvrdit heslo", maxlength: 72, class: "w-full input" %>

      <div class="w-full flex justify-center">
        <%= form.submit "Registrovat se", class: "btn btn-primary mt-8 md:max-w-48 w-full" %>
      </div>
      <div class="mt-8 text-sm text-center text-gray-500 ">
        Máte už účet? <%= link_to "Přihlaste se", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </fieldset>
  <% end %>
</div>
