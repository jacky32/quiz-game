
<div class="mx-auto md:w-96 w-full">
  <%= form_for @user, url: registrations_path do |form| %>
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4">
      <h1 class="font-bold text-4xl mb-4">Registrace</h1>
      <%= image_tag "logo.png" %>

      <label class="label" for="name">Jméno</label>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "nickname", placeholder: "Jméno", value: params[:name], class: "input" %>

      <label class="label" for="email_address">Email</label>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "Email", value: params[:email_address], class: "input" %>

      <label class="label" for="password">Heslo</label>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Heslo", maxlength: 72, class: "input" %>

      <label class="label" for="password">Potvrdit heslo</label>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "current-password", placeholder: "Potvrdit heslo", maxlength: 72, class: "input" %>

      <div class="flex justify-center">
        <%= form.submit "Registrovat se", class: "btn btn-primary mt-8 max-w-48 w-full" %>
      </div>
      <div class=" mt-8 text-center text-sm text-gray-500 ">
        Máte už účet? <%= link_to "Přihlaste se", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </fieldset>
  <% end %>
</div>
