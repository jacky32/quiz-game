<%# Header %>
<section class="grid grid-cols-1 grid-rows-2 md:grid-cols-3 md:grid-rows-2 w-full bg-base-200  ">
  <div class="flex items-center justify-evenly md:justify-center w-full h-28 flex-row md:flex-col col-span-1 border-base-300 md:border-b-2 ">
    <div class="text-lg md:text-xl font-semibold">Současné skóre: <%= Current.user.load_total_score %></div>
    <div class="text-lg max-md:hidden">Pořadí v žebříčku: <%= Current.user.leaderboard_position %></div>
    <div class="md:hidden">
      <%= link_to edit_user_path(Current.user) do %>
        <%= image_tag Current.user.avatar, class: "h-24 w-24 rounded-full" if Current.user.avatar.attached? %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-center w-full flex-col md:row-span-2 border-base-300 md:border-b-2 ">
    <%= image_tag "logo.png", class: "h-36 max-md:hidden" %>
    <div class="text-2xl">Vítejte, <%= Current.user.name %>!</div>
  </div>

  <div class="hidden md:flex flex-row items-center justify-center w-full h-28 gap-4 border-base-300 border-b-2">
    <%= link_to edit_user_path(Current.user), class: "text-lg" do %>
      <%= Current.user.name %>
    <% end %>
    <%= link_to edit_user_path(Current.user) do %>
      <%= image_tag Current.user.avatar, class: "h-24 w-24 rounded-full" if Current.user.avatar.attached? %>
    <% end %>
  </div>
  <div class="bg-base-100 border-base-300 border-r-2"></div>
  <div class="bg-base-100 border-base-300 border-l-2"></div>
</section>

<%# Top players %>

<section class="flex w-full h-auto flex-col-reverse md:flex-row">
  <%= turbo_stream_from "leaderboard" %>
  <%= turbo_frame_tag "leaderboard", class: "flex flex-row items-center justify-center w-full h-full gap-4 m-2 card  rounded-box min-h-96" do %>
    <%= render partial: "leaderboard" %>
  <% end %>
  <div class="flex flex-col items-center justify-center w-full h-full gap-4 m-2 card rounded-box min-h-96 shadow-md p-4 list bg-base-100">
    <div class="text-lg">Chcete být milionářem?</div>
    <%= link_to Current.user.playthroughs.in_progress.any? ? "Pokračovat ve hře" : "Začít hru", playthroughs_path, class: "btn btn-primary" %>
    <div class="text-md">Hra je postavena na klasickém formátu vědomostní pyramidy, kde hráč postupuje sérií otázek s rostoucí obtížností a bodovou hodnotou. U každé otázky má výběr ze čtyř možností s jednou správnou odpovědí. K dispozici má tři různé nápovědy: 50:50 která vyřadí dvě špatné odpovědi, nápověda, která zobrazí nápovědu k otázce a možnost výměny otázky za jinou. Každá nápověda může být využita pouze jednou za hru. </div>
  </div>
</section>
