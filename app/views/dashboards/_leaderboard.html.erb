<ul class="w-full h-full m-4 shadow-md list bg-base-100 rounded-box">
  <li class="p-4 pb-2 text-xs tracking-wide opacity-60">Top hráči</li>

  <% User.top_leaderboard.includes(avatar_attachment: :blob).each.with_index(1) do |user, index| %>
    <li class="list-row">
      <div class="text-4xl font-thin opacity-30 tabular-nums"><%= index %></div>
      <div>
        <% if user.avatar.attached? %>
          <%= image_tag user.avatar, class: "size-10 rounded-box" %>
        <% end %>
      </div>
      <div class="list-col-grow"><%= user.name %></div>
      <div class="text-xs font-semibold uppercase opacity-60"><%= user.total_score %></div>
    </li>
  <% end %>
</ul>
