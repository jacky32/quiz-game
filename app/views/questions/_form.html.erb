<%= form_with(model: question, class: "contents") do |form| %>
  <% if question.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(question.errors.count, "error") %> prohibited this question from being saved:</h2>

      <ul class="list-disc ml-6">
        <% question.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:name].none?, "border-red-400 focus:outline-red-600": question.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :body %>
    <%= form.textarea :body, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:body].none?, "border-red-400 focus:outline-red-600": question.errors[:body].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :correct_answer %>
    <%= form.textarea :correct_answer, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:correct_answer].none?, "border-red-400 focus:outline-red-600": question.errors[:correct_answer].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :wrong_answer1 %>
    <%= form.textarea :wrong_answer1, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:wrong_answer1].none?, "border-red-400 focus:outline-red-600": question.errors[:wrong_answer1].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :wrong_answer2 %>
    <%= form.textarea :wrong_answer2, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:wrong_answer2].none?, "border-red-400 focus:outline-red-600": question.errors[:wrong_answer2].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :wrong_answer3 %>
    <%= form.textarea :wrong_answer3, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:wrong_answer3].none?, "border-red-400 focus:outline-red-600": question.errors[:wrong_answer3].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :level %>
    <%= form.number_field :level, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:level].none?, "border-red-400 focus:outline-red-600": question.errors[:level].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :hint %>
    <%= form.textarea :hint, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": question.errors[:hint].none?, "border-red-400 focus:outline-red-600": question.errors[:hint].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
