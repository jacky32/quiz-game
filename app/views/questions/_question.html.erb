<div id="<%= dom_id question %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= question.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Body:</strong>
    <%= question.body %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Correct answer:</strong>
    <%= question.correct_answer %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Wrong answer1:</strong>
    <%= question.wrong_answer1 %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Wrong answer2:</strong>
    <%= question.wrong_answer2 %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Wrong answer3:</strong>
    <%= question.wrong_answer3 %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Level:</strong>
    <%= question.level %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Hint:</strong>
    <%= question.hint %>
  </div>
</div>
