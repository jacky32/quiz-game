
<section class="flex w-full bg-base-200 border-b-2 border-base-300">
  <div class="flex flex-row items-center justify-start w-full h-24 gap-4 m-2">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", class: "h-24" %>
    <% end %>
    </div>
  <div class="flex flex-row items-center justify-center w-full h-24 gap-4 m-2">
    <%= yield %>
  </div>
  <div class="flex flex-row items-center justify-end w-full h-24 gap-4 m-2">
    <%= link_to edit_user_path(Current.user), class: "text-lg" do %>
      <%= Current.user.name %>
    <% end %>
    <% if Current.user.avatar.attached? %>
      <%= image_tag Current.user.avatar, class: "h-24 w-24 rounded-full" %>
    <% else %>
      <div class="h-24 w-24 rounded-full cursor-pointer bg-gray-300 flex items-center justify-center text-3xl text-white">
        <%= Current.user.name.first.upcase %>
      </div>
    <% end %>
  </div>
</section>
